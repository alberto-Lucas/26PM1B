<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMVC.Views.pgVisualizarPessoaView"
             Title="pgVisualizarPessoaView">
    <StackLayout>
        <Button Text="Voltar"
                Clicked="btnVoltar_Clicked"/>

        <Label Text="Id:"/>
        <Label x:Name="lblId" FontSize="20"/>
        <Label Text="Nome:"/>
        <Label x:Name="lblNome" FontSize="20"/>
        <Label Text="CPF:"/>
        <Label x:Name="lblCPF" FontSize="20"/>

        <Image x:Name="imgCadastro"
               MaximumHeightRequest="300"
               MaximumWidthRequest="300"
               HorizontalOptions="Center"
               VerticalOptions="Center"/>
    </StackLayout>
</ContentPage>