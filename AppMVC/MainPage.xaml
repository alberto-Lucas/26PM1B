<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppMVC.MainPage">
    <StackLayout Padding="10">
        <!--Botoes Acesso-->
        <StackLayout>
            <Button Text="Cadastrar"
                    Clicked="btnCadastrar_Clicked"
                    FontSize="20"
                    Margin="0, 10, 0, 0"/>

            <Button Text="Atualizar"
                    Clicked="btnAtualizar_Clicked"
                    FontSize="20"
                    Margin="0, 10, 0, 0"/>
        </StackLayout>
        <!--Listagem-->
        <ListView x:Name="lsvRegistros">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <!--Definir a aparencia dos registros-->
                        <Frame CornerRadius="10"
                               Padding="10"
                               Margin="5"
                               BackgroundColor="#414142">
                            <!--Stack principal-->
                            <StackLayout Orientation="Horizontal">
                                <!--Stack da imagem-->
                                <StackLayout HorizontalOptions="Fill"
                                             Padding="10">
                                    <Image Source="{Binding DirImagem}"
                                           HeightRequest="50"
                                           WidthRequest="50"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>
                                </StackLayout>
                                <!--Stack do dados-->
                                <StackLayout HorizontalOptions="FillAndExpand">
                                    <Label Text="{Binding Id}"/>
                                    <Label Text="{Binding Nome}"
                                           FontSize="20"
                                           FontAttributes="Bold"/>
                                    <!--stack para o CPF-->
                                    <StackLayout Orientation="Horizontal">
                                        <Label Text="CPF: "/>
                                        <Label Text="{Binding CPF}"
                                               Margin="5, 0"/>
                                    </StackLayout>
                                </StackLayout>
                                <!--stack icones-->
                                <StackLayout HorizontalOptions="End"
                                             Padding="5"
                                             Orientation="Horizontal">
                                    <Image Source="icon_eye.png"
                                           WidthRequest="30"
                                           HeightRequest="30">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Tapped="tapVisualizar_Tapped"
                                                CommandParameter="{Binding .}"/>
                                        </Image.GestureRecognizers>
                                    </Image>

                                    <Image Source="icon_trash.png"
                                           WidthRequest="30"
                                           HeightRequest="30">
                                        <Image.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Tapped="tapDeletar_Tapped"
                                                CommandParameter="{Binding .}"/>
                                        </Image.GestureRecognizers>
                                    </Image>
                                </StackLayout>
                            </StackLayout>
                        </Frame>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackLayout>    
</ContentPage>
